    signup.html
    <!DOCTYPE html>
    <html lang="ar">
    <head>
    <meta charset="UTF-8" />
    <title>تسجيل الدخول</title>
    <style>
        /* تنسيق بسيط */
        body {
        display: flex; justify-content: center; align-items: center; height: 100vh;
        font-family: Arial, sans-serif;
        background: linear-gradient(45deg, #00c6ff, #0072ff);
        color: #333;
        }
        .login-box {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        width: 300px;
        text-align: center;
        }
        input, button {
        width: 100%; margin: 10px 0; padding: 10px; border-radius: 4px; border: 1px solid #ccc;
        }
        button {
        background-color: #0072ff; color: white; border: none; cursor: pointer;
        }
        p#message {
        color: red;
        min-height: 20px;
        }
    </style>
    </head>
    <body>

    <div class="login-box">
        <h2>تسجيل الدخول</h2>
        <form onsubmit="login(event)">
        <input type="email" id="email" placeholder="البريد الإلكتروني" required />
        <input type="password" id="password" placeholder="كلمة السر" required />
        <button type="submit">دخول</button>
        </form>
        <p id="message"></p>
        <p><a href="signup.html">إنشاء حساب جديد</a></p>
    </div>

    <script src="login.js"></script>
    <script>
        function login(event) {
        event.preventDefault();

        const email = document.getElementById("email").value;
        const password = document.getElementById("password").value;
        const storedUser = JSON.parse(localStorage.getItem("userData"));

        if (!storedUser) {
            document.getElementById("message").innerText = "لا يوجد حساب مسجل، يرجى التسجيل أولاً.";
            return;
        }

        if (email === storedUser.email && password === storedUser.password) {
            document.getElementById("message").style.color = "green";
            document.getElementById("message").innerText = "تم تسجيل الدخول بنجاح!";

            // ممكن توجه المستخدم لصفحة أخرى هنا مثل الصفحة الرئيسية
            // window.location.href = "profile.html";
        } else {
            document.getElementById("message").style.color = "red";
            document.getElementById("message").innerText = "البريد الإلكتروني أو كلمة السر غير صحيحة.";
        }
        }
    </script>
    </body>
    </html>
